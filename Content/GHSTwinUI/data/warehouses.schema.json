{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "全球仓库目录 v2",
  "type": "object",
  "required": ["schemaVersion", "coordinateSystem", "warehouses"],
  "properties": {
    "schemaVersion": {"const": 2},
    "coordinateSystem": {"const": "WGS84"},
    "warehouses": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "name", "latitude", "longitude", "map", "runtimeProfile", "features"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!cluster[-:])", "description": "稳定仓库标识；cluster- 和 cluster: 为聚合点保留前缀，区分大小写。"},
          "name": {"type": "string", "minLength": 1},
          "city": {"type": "string"},
          "cityShort": {"type": "string"},
          "address": {"type": "string"},
          "region": {"type": "string"},
          "country": {"type": "string"},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "map": {"type": "string", "pattern": "^/Game/Maps/[A-Za-z0-9_/]+$"},
          "thumbnail": {"type": "string", "pattern": "^assets/"},
          "runtimeProfile": {"enum": ["ghs", "generic"]},
          "features": {"type": "array", "uniqueItems": true, "items": {"enum": ["warehouse-ui", "traffic"]}},
          "entryCamera": {
            "type": "object", "required": ["x", "y", "z", "distance", "pitch", "yaw"],
            "properties": {
              "x": {"type": "number", "minimum": -100000000, "maximum": 100000000},
              "y": {"type": "number", "minimum": -100000000, "maximum": 100000000},
              "z": {"type": "number", "minimum": -100000000, "maximum": 100000000},
              "distance": {"type": "number", "minimum": 900, "maximum": 95000},
              "pitch": {"type": "number", "minimum": -80, "maximum": -15},
              "yaw": {"type": "number"}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"runtimeProfile": {"const": "generic"}}}, "then": {"required": ["entryCamera"], "properties": {"features": {"maxItems": 0}}}},
          {"if": {"properties": {"runtimeProfile": {"const": "ghs"}}}, "then": {"properties": {"features": {"contains": {"const": "warehouse-ui"}}}}}
        ]
      }
    }
  }
}
