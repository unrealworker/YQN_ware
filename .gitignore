# Visual Studio 2015 user specific files
.vs/
.idea/
# Compiled Object files
*.slo
*.lo
*.o
#*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
#*.dylib
#*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
#*.lib

# Executables
*.exe
*.out
*.app
*.ipa
.vsconfig
*.DotSettings.user

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
Content/Developers/
Content/Videos/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
# Don't ignore icon files in Build
!Build/**/*.ico
!Plugins/**/Binaries/ThirdParty/
!Plugins/**/Binaries/ThirdParty/**
!Plugins/**/Source/
!Plugins/**/Source/**
Plugins/**/*.log
# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
PAK/*
Saved/*
Content/__ExternalActors__/*
Content/__ExternalObjects__/*
Plugins/**/__ExternalActors__/*
Plugins/**/__ExternalObjects__/*
# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

Design/*
Deployment/*
WareProductData/*
CADGis/*
Package_Server/*
Package_Windows/*
Package_PublicStreaming_*/
